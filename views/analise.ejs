<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <title>Análise da Semana</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/logo-fitcheck.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/analise.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
</head>
<body class="an-body">
  <%- include('partials/topbar') %>

  <%
    const usadas = limiteAtingido ? limite : numeroAnalise;
    const progresso = Math.round((usadas / limite) * 100);
    const deslocamento = (113.1 * (1 - usadas / limite)).toFixed(1);
  %>

  <main class="an-page">
    <section class="an-card an-head">
      <div>
        <h1 class="an-title">Análise <strong><%= usadas %> de <%= limite %></strong></h1>
        <p class="an-sub">Com base nos teus últimos 7 registos.</p>
      </div>
      <div class="an-ring-wrap">
        <svg class="an-ring" viewBox="0 0 44 44" aria-hidden="true">
          <circle class="an-ring-bg" cx="22" cy="22" r="18"></circle>
          <circle class="an-ring-fg" cx="22" cy="22" r="18" stroke-dasharray="113.1" stroke-dashoffset="<%= deslocamento %>"></circle>
        </svg>
        <span class="an-ring-label"><%= progresso %>%</span>
      </div>
    </section>

    <% if (limiteAtingido) { %>
      <section class="an-card an-limit">
        <p>Atingiste o limite de <%= limite %> análises de teste. Obrigado por experimentar o FitCheck!</p>
      </section>
    <% } else { %>
      <section class="an-card">
        <p class="an-status" id="analise-estado" role="status">A analisar os teus registos...</p>
        <p class="analise-texto" id="analise-texto"><span class="cursor"></span></p>
      </section>
      <p class="an-notice">
        Os teus últimos 7 registos são enviados à Groq para gerar esta análise.
        É informação geral e não substitui aconselhamento médico.
      </p>
    <% } %>

    <a class="an-back" href="/registros/historico">Voltar ao Histórico</a>
  </main>

  <% if (!limiteAtingido) { %>
    <script src="/analise.js"></script>
  <% } %>
</body>
</html>
